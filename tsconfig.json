{
  "extends": "zotero-types/entries/sandbox/",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022"
  },
  "include": ["src", "typings"],
  "exclude": ["build", "addon", "node_modules"]
}
