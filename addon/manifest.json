{
  "manifest_version": 2,
  "name": "RapidOCR for Zotero",
  "version": "1.7.0",
  "description": "开装即用：在 Zotero 内用 RapidOCR 把扫描 PDF 做成可搜索、可选择的 PDF。无需 Python / Tesseract。",
  "author": "chen7447",
  "icons": {
    "48": "content/icons/pdf-ocr.svg",
    "96": "content/icons/pdf-ocr.svg"
  },
  "applications": {
    "zotero": {
      "id": "pdfocrforzotero@example.com",
      "update_url": "https://raw.githubusercontent.com/chen7447/rapidocr-for-zotero/main/update.json",
      "strict_min_version": "9.0",
      "strict_max_version": "10.0.*"
    }
  }
}