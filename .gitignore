# Local/private OCR fixtures and generated test artifacts
/tests/fixtures/local-private/
/tests/fixtures/generated/*.pdf
/tests/fixtures/generated/*.png
/tests/fixtures/generated/*.txt
/tests/fixtures/generated/*.json

# Local check artifacts (one-off debug scripts live in /tools/debug)
/tools/debug/*.pdf
/tools/debug/*.rgba
/tools/debug/*.jpg
/tools/debug/*.raw
/tools/debug/python_*

# Build and dependency output
/node_modules/
/.scaffold/
/build/
/dist/
/coverage/
*.tsbuildinfo
/worker/.venv/
/worker/.pytest_cache/
/worker/**/__pycache__/

# Secrets and local configuration
.env
.env.*
!.env.example
*.log

# Zotero debug output dumps (user data, never commit)
/Debug Output.htm
/Debug Output_files/
